-- Seccion DDL

CREATE DATABASE BodegaTech ;

USE BodegaTech ;

DROP TABLE IF EXISTS Inventario;

CREATE TABLE Inventario(
id_producto int NOT NULL IDENTITY(1,1) PRIMARY KEY,
nombre_producto varchar(100),
categoria varchar(50),
precio_unitario decimal(10,2), --Corresponde a un precio con decimales
stock_actual int,
stock_minimo int, --Valor entero ya que habla de stock
fecha_ingreso date, --Es una fecha sin hora
activo int
);

